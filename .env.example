# Google Apps Script web-app URL (Deploy > New deployment > Web app,
# "Execute as: me", "Who has access: Anyone"). Copy to .env.local to use.
VITE_SHEETS_ENDPOINT=https://script.google.com/macros/s/XXXXXXXX/exec

# Must match SUBMIT_TOKEN in the Apps Script. Keeps drive-by junk out of the sheet.
VITE_SUBMIT_TOKEN=change-me

